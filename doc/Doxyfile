##======================================================================================================================
## Only what belongs to this project. What the fleet shares comes from the @INCLUDE at the bottom, what can be worked
## out from the project's name is worked out there too, and anything named nowhere is a doxygen default we have no
## reason to restate.
##======================================================================================================================

PROJECT_BRIEF          = "The Tiny Test System"
PROJECT_LOGO           = logo.svg
LAYOUT_FILE            = layout.xml

## What to read, and where the @include of a snippet looks for its file
INPUT                  = ../include .
INCLUDE_PATH           = ../include
EXAMPLE_PATH           = ../test/unit/doc ../test/integration .
FILE_PATTERNS          = *.hpp *.md

## How much of a page to unfold
SHOW_HEADERFILE        = NO
SHOW_NAMESPACES        = NO
TOC_INCLUDE_HEADINGS   = 5

GENERATE_LATEX         = NO

##======================================================================================================================
## What the fleet shares, last so that it wins over anything above
##======================================================================================================================
@INCLUDE               = $(DOXYGEN_ASSETS)/base.doxyfile
